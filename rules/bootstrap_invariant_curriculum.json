    {
      "id": "combined-sentinel-regression",
      "description": "Cross-suite sentinel families to guard finality+template regressions.",
      "suite": "combined",
      "max_cycles": 2,
      "families": [
        "buy_more_final_gap",
        "buy_more_then_donation_and_spoilage",
        "buy_more_then_donation_after_spoilage_long_tail",
        "unit_conversion_dozen",
        "percent_sequence_growth",
        "percent_sequence_discount"
      ],
      "gates": [
        {
          "id": "hybrid-sentinel-all-valid-solves",
