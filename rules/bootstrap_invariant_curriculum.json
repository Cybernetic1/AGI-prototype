          "op": ">=",
          "value": 1.0,
          "blocking": true
        },
        {
          "id": "hybrid-template-core-symbolic-perfect",
          "description": "Hybrid symbolic validity must remain perfect on template-core.",
          "profile": "hybrid",
          "metric": "symbolic_validity.symbolic_valid_rate",
          "op": ">=",
          "value": 1.0,
          "blocking": true
        },
        {
          "id": "lt-heavy-template-core-solve-floor",
          "description": "LT-heavy solve floor for template-core families.",
          "profile": "lt-heavy",
          "metric": "capability.solve_rate",
          "op": ">=",
          "value": 0.875,
          "blocking": true
        },
        {
          "id": "lt-heavy-template-core-symbolic-floor",
          "description": "LT-heavy symbolic validity floor for template-core families.",
          "profile": "lt-heavy",
          "metric": "symbolic_validity.symbolic_valid_rate",
          "op": ">=",
          "value": 0.875,
          "blocking": true
        },
        {
          "id": "ilp-heavy-template-core-symbolic-floor",
          "description": "ILP-heavy symbolic validity floor (monitor-only).",
          "profile": "ilp-heavy",
          "metric": "symbolic_validity.symbolic_valid_rate",
          "op": ">=",
          "value": 0.25,
          "blocking": false
        }
      ]
    },
    {
      "id": "adjacent-template-full",
      "description": "Full compact generalized template family slice.",
      "suite": "template_generalization",
      "max_cycles": 2,
      "families": [
        "product_total",
        "rate_time_total",
        "discount_price",
